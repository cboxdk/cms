{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cbox-cms:theme.v1",
  "title": "A theme of the Cbox CMS panel",
  "description": "Generated by `npm run generate:tokens` from js/ui-kit/tokens.json. Do not edit it by hand: edit the JSON and run the script again; gate 6 fails when this file differs from what it writes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tokens": {
      "$ref": "#/$defs/tokens"
    },
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status-screen": {
          "description": "The panel of a status page, such as the page for an address the panel does not have.",
          "$ref": "#/$defs/tokens"
        },
        "task-screen": {
          "description": "The panel of a page for one task outside the panel's navigation, such as signing in.",
          "$ref": "#/$defs/tokens"
        }
      }
    }
  },
  "$defs": {
    "color": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:#[0-9a-f]{6}|oklch\\(\\d+(?:\\.\\d+)?% \\d+(?:\\.\\d+)? \\d+(?:\\.\\d+)?\\))$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^(?:#[0-9a-f]{6}|oklch\\(\\d+(?:\\.\\d+)?% \\d+(?:\\.\\d+)? \\d+(?:\\.\\d+)?\\))$"
            },
            "dark": {
              "type": "string",
              "pattern": "^(?:#[0-9a-f]{6}|oklch\\(\\d+(?:\\.\\d+)?% \\d+(?:\\.\\d+)? \\d+(?:\\.\\d+)?\\))$"
            }
          }
        }
      ]
    },
    "length": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0|\\d+(?:\\.\\d+)?(?:px|rem|em|%))$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^(?:0|\\d+(?:\\.\\d+)?(?:px|rem|em|%))$"
            },
            "dark": {
              "type": "string",
              "pattern": "^(?:0|\\d+(?:\\.\\d+)?(?:px|rem|em|%))$"
            }
          }
        }
      ]
    },
    "duration": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+ms$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^\\d+ms$"
            },
            "dark": {
              "type": "string",
              "pattern": "^\\d+ms$"
            }
          }
        }
      ]
    },
    "number": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            },
            "dark": {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            }
          }
        }
      ]
    },
    "font-family": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:-?[A-Za-z][A-Za-z0-9-]*|'[A-Za-z0-9 -]+')(?:, (?:-?[A-Za-z][A-Za-z0-9-]*|'[A-Za-z0-9 -]+'))*$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^(?:-?[A-Za-z][A-Za-z0-9-]*|'[A-Za-z0-9 -]+')(?:, (?:-?[A-Za-z][A-Za-z0-9-]*|'[A-Za-z0-9 -]+'))*$"
            },
            "dark": {
              "type": "string",
              "pattern": "^(?:-?[A-Za-z][A-Za-z0-9-]*|'[A-Za-z0-9 -]+')(?:, (?:-?[A-Za-z][A-Za-z0-9-]*|'[A-Za-z0-9 -]+'))*$"
            }
          }
        }
      ]
    },
    "shadow": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:inset )?(?:-?\\d+(?:\\.\\d+)?(?:px)? ){2,4}#[0-9a-f]{6}(?:, (?:inset )?(?:-?\\d+(?:\\.\\d+)?(?:px)? ){2,4}#[0-9a-f]{6})*$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^(?:inset )?(?:-?\\d+(?:\\.\\d+)?(?:px)? ){2,4}#[0-9a-f]{6}(?:, (?:inset )?(?:-?\\d+(?:\\.\\d+)?(?:px)? ){2,4}#[0-9a-f]{6})*$"
            },
            "dark": {
              "type": "string",
              "pattern": "^(?:inset )?(?:-?\\d+(?:\\.\\d+)?(?:px)? ){2,4}#[0-9a-f]{6}(?:, (?:inset )?(?:-?\\d+(?:\\.\\d+)?(?:px)? ){2,4}#[0-9a-f]{6})*$"
            }
          }
        }
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color-surface": {
          "description": "The background of the page and of controls.",
          "$ref": "#/$defs/color"
        },
        "color-surface-raised": {
          "description": "The background of a panel or a button that sits on the surface.",
          "$ref": "#/$defs/color"
        },
        "color-text": {
          "description": "Body text and headings.",
          "$ref": "#/$defs/color"
        },
        "color-text-muted": {
          "description": "Secondary text, such as a field's hint or a page's description.",
          "$ref": "#/$defs/color"
        },
        "color-border": {
          "description": "Borders that only group content and carry no meaning of their own.",
          "$ref": "#/$defs/color"
        },
        "color-border-strong": {
          "description": "The border of a control, which shows where it is, so it meets the contrast of a user interface part.",
          "$ref": "#/$defs/color"
        },
        "color-accent": {
          "description": "The colour of links and of the primary action.",
          "$ref": "#/$defs/color"
        },
        "color-accent-hover": {
          "description": "The accent under the pointer.",
          "$ref": "#/$defs/color"
        },
        "color-on-accent": {
          "description": "Text on the accent, such as the label of a primary button.",
          "$ref": "#/$defs/color"
        },
        "color-danger": {
          "description": "Errors and destructive actions.",
          "$ref": "#/$defs/color"
        },
        "color-focus": {
          "description": "The colour of the focus ring.",
          "$ref": "#/$defs/color"
        },
        "font-family": {
          "description": "The typeface of all text.",
          "$ref": "#/$defs/font-family"
        },
        "font-family-mono": {
          "description": "The typeface of codes and identifiers.",
          "$ref": "#/$defs/font-family"
        },
        "font-size-sm": {
          "description": "Small text, such as a status code.",
          "$ref": "#/$defs/length"
        },
        "font-size-md": {
          "description": "The text of controls, labels and hints.",
          "$ref": "#/$defs/length"
        },
        "font-size-lg": {
          "description": "Body text and the value of an input.",
          "$ref": "#/$defs/length"
        },
        "font-size-xl": {
          "description": "A page's heading.",
          "$ref": "#/$defs/length"
        },
        "font-weight-regular": {
          "description": "The weight of body text.",
          "$ref": "#/$defs/number"
        },
        "font-weight-medium": {
          "description": "The weight of labels, buttons and links.",
          "$ref": "#/$defs/number"
        },
        "font-weight-semibold": {
          "description": "The weight of headings.",
          "$ref": "#/$defs/number"
        },
        "line-height": {
          "description": "The line height of body text.",
          "$ref": "#/$defs/number"
        },
        "line-height-tight": {
          "description": "The line height of headings.",
          "$ref": "#/$defs/number"
        },
        "space-1": {
          "description": "The smallest space, such as between a label and its input.",
          "$ref": "#/$defs/length"
        },
        "space-2": {
          "description": "A small space, such as inside a button.",
          "$ref": "#/$defs/length"
        },
        "space-3": {
          "description": "A space between related items.",
          "$ref": "#/$defs/length"
        },
        "space-4": {
          "description": "The space between the fields of a form.",
          "$ref": "#/$defs/length"
        },
        "space-6": {
          "description": "The space between the parts of a panel.",
          "$ref": "#/$defs/length"
        },
        "space-8": {
          "description": "The largest space, such as the padding of a panel.",
          "$ref": "#/$defs/length"
        },
        "radius-sm": {
          "description": "The rounding of small parts, such as the focus ring of a link.",
          "$ref": "#/$defs/length"
        },
        "radius-md": {
          "description": "The rounding of controls.",
          "$ref": "#/$defs/length"
        },
        "radius-lg": {
          "description": "The rounding of panels.",
          "$ref": "#/$defs/length"
        },
        "focus-ring": {
          "description": "The focus ring of every control: a gap in the surface's colour and a ring in the focus colour.",
          "$ref": "#/$defs/shadow"
        },
        "duration-fast": {
          "description": "Short transitions, such as a hover. It is 0 when the reader prefers reduced motion.",
          "$ref": "#/$defs/duration"
        },
        "target-size": {
          "description": "The smallest height of a pointer target: at least 24 pixels (WCAG 2.2, 2.5.8).",
          "$ref": "#/$defs/length"
        },
        "measure": {
          "description": "The widest a panel of running text grows.",
          "$ref": "#/$defs/length"
        },
        "button-radius": {
          "description": "The rounding of a button.",
          "$ref": "#/$defs/length"
        }
      }
    }
  }
}
