{
    "name": "cboxdk/laravel-cms",
    "description": "Cbox CMS monorepo: the kernel packages, the workbench and the development tooling.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Cbox",
            "homepage": "https://cboxdk.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "cboxdk/cms-cli": "^0.1@dev",
        "cboxdk/cms-contracts": "^0.1@dev",
        "cboxdk/cms-core": "^0.1@dev",
        "cboxdk/cms-generators": "^0.1@dev",
        "cboxdk/cms-http": "^0.1@dev",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "cboxdk/cms-testkit": "^0.1@dev",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "cboxdk/cms-cli": "0.1.x-dev",
                    "cboxdk/cms-contracts": "0.1.x-dev",
                    "cboxdk/cms-core": "0.1.x-dev",
                    "cboxdk/cms-generators": "0.1.x-dev",
                    "cboxdk/cms-http": "0.1.x-dev",
                    "cboxdk/cms-testkit": "0.1.x-dev"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Cms\\Cli\\Tests\\": "packages/cli/tests/",
            "Cbox\\Cms\\Contracts\\Tests\\": "packages/contracts/tests/",
            "Cbox\\Cms\\Core\\Tests\\": "packages/core/tests/",
            "Cbox\\Cms\\Generators\\Tests\\": "packages/generators/tests/",
            "Cbox\\Cms\\Http\\Tests\\": "packages/http/tests/",
            "Cbox\\Cms\\Testkit\\Tests\\": "packages/testkit/tests/",
            "Cbox\\Cms\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        },
        "classmap": [
            "packages/testkit/tests/Phpstan/Fixtures/"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/pest",
        "services:up": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose up -d --wait"
        ],
        "services:down": "docker compose down",
        "lint": "@php vendor/bin/pint",
        "lint:check": "@php vendor/bin/pint --test",
        "rector": "@php vendor/bin/rector process",
        "rector:check": "@php vendor/bin/rector process --dry-run",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts-descriptions": {
        "clear": "Reset the Testbench application skeleton in vendor/.",
        "prepare": "Discover the packages' service providers for the Testbench application.",
        "test": "Run the Pest suite for the monorepo and every package.",
        "services:up": "Start PHP 8.5, Postgres 17 and Valkey from compose.yaml and wait until they are healthy.",
        "services:down": "Stop the services from compose.yaml. The data volumes are kept.",
        "lint": "Format the PHP code with Pint and the shared configuration from the testkit.",
        "lint:check": "Gate 1: fail if Pint would change any file.",
        "rector": "Apply the shared Rector sets from the testkit.",
        "rector:check": "Gate 2: fail if Rector would change any file.",
        "analyse": "Gate 3: PHPStan level 10 with Larastan over the packages, the tests and the workbench, without a baseline."
    }
}
