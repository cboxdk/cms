{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@cboxdk/cms-tooling/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "*.js",
    "js/*/*.js",
    "js/*/src/**/*",
    "workbench/resources/js/**/*",
    "packages/*/resources/typescript/**/*",
    "packages/generators/tests/Descriptor/Fixtures/Comprehensive/typescript/**/*",
    "tests/Support/TypeScript/*.ts"
  ]
}
