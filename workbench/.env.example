# Local development against the services in compose.yaml (`composer services:up`).
# Testbench copies this file to the workbench application when workbench/.env is missing;
# copy it to workbench/.env to change a value. The tests use phpunit.xml instead.

APP_NAME="Cbox CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# The app role: no DDL, NOBYPASSRLS, transaction_timeout 5s (PRD 4.2, GUARDRAILS 6).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54317
DB_DATABASE=cms
DB_SCHEMA=cms
DB_USERNAME=cms_app
DB_PASSWORD=cms_app

# The owner role for migrations and partition maintenance (connection pgsql_owner).
DB_OWNER_USERNAME=cms_owner
DB_OWNER_PASSWORD=cms_owner

# The identity role of the credential store of the local accounts (connection pgsql_identity):
# DML on the schema cms_identity only, which the app role cannot read (PRD 5.16).
DB_IDENTITY_USERNAME=cms_identity
DB_IDENTITY_PASSWORD=cms_identity

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=63797

# Laravel's session, which the panel uses only for Inertia's flash data, the errors prop and the
# CSRF token, in Valkey on the default Redis connection (docs/security/sessions.md). The panel's
# credential, the CMS session, lives in Valkey of its own accord.
SESSION_DRIVER=redis
SESSION_CONNECTION=default
