<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnPhpunitDeprecations="true"
>
    <!--
        The Pest suites of gate 5 in GUARDRAILS 10. The actions suite arrives in M1 with the first
        action, and the browser suite with the browser plugin.
          Unit      no services: the monorepo's tooling, manifest and provider tests, and every
                    package test outside the directories below
          Codecs    PHP codec output against the browser's validator
          Contract  the same suite against the fake and the real adapter of each contract
          Postgres  real Postgres and Valkey from compose.yaml; run `composer services:up` first
          Arch      the architecture rules
        A package puts its tests for a suite in packages/<package>/tests/<Suite>.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Feature</directory>
            <directory suffix="Test.php">packages/*/tests</directory>
            <exclude>packages/*/tests/Codecs</exclude>
            <exclude>packages/*/tests/Contract</exclude>
            <exclude>packages/*/tests/Postgres</exclude>
        </testsuite>
        <testsuite name="Codecs">
            <directory suffix="Test.php">tests/Codecs</directory>
            <directory suffix="Test.php">packages/*/tests/Codecs</directory>
        </testsuite>
        <testsuite name="Contract">
            <directory suffix="Test.php">tests/Contract</directory>
            <directory suffix="Test.php">packages/*/tests/Contract</directory>
        </testsuite>
        <testsuite name="Postgres">
            <directory suffix="Test.php">tests/Postgres</directory>
            <directory suffix="Test.php">packages/*/tests/Postgres</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory suffix="Test.php">tests/Arch</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/*/src</directory>
            <directory>workbench/app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            The services from compose.yaml on their host ports. Inside the php container,
            compose sets DB_HOST, DB_PORT, REDIS_HOST and REDIS_PORT to the service names,
            and PHPUnit keeps a variable that is already set.
            Tests run as the app role (GUARDRAILS 6); pgsql_owner is the owner role.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="54317"/>
        <env name="DB_DATABASE" value="cms_test"/>
        <env name="DB_SCHEMA" value="cms"/>
        <env name="DB_USERNAME" value="cms_app"/>
        <env name="DB_PASSWORD" value="cms_app"/>
        <env name="DB_OWNER_USERNAME" value="cms_owner"/>
        <env name="DB_OWNER_PASSWORD" value="cms_owner"/>
        <env name="REDIS_CLIENT" value="phpredis"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="63797"/>
    </php>
</phpunit>
