{
  "name": "cboxdk/cms-cli",
  "description": "Cbox CMS CLI surface: the cms:* Artisan commands.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Cbox",
      "homepage": "https://cboxdk.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "cboxdk/cms-contracts": "^0.1",
    "cboxdk/cms-core": "^0.1",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Cbox\\Cms\\Cli\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cbox\\Cms\\Cli\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cbox\\Cms\\Cli\\CliServiceProvider"
      ]
    }
  }
}
