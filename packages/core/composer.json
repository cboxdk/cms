{
  "name": "cboxdk/cms-core",
  "description": "Cbox CMS core: the command kernel, pipelines, storage and event log.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Cbox",
      "homepage": "https://cboxdk.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "cboxdk/cms-contracts": "^0.1",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/redis": "^13.0",
    "illuminate/support": "^13.0",
    "psr/clock": "^1.0",
    "symfony/process": "^7.4.5 || ^8.0.5"
  },
  "autoload": {
    "psr-4": {
      "Cbox\\Cms\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cbox\\Cms\\Core\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cbox\\Cms\\Core\\CoreServiceProvider"
      ]
    }
  }
}
