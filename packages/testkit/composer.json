{
  "name": "cboxdk/cms-testkit",
  "description": "Cbox CMS testkit: fakes, shared contract tests, the real-Postgres test harness and the shared Pint, Rector and PHPStan configuration for the core and for addons.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Cbox",
      "homepage": "https://cboxdk.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "cboxdk/cms-contracts": "^0.1",
    "driftingly/rector-laravel": "^2.6",
    "larastan/larastan": "^3.12",
    "laravel/framework": "^13.0",
    "laravel/pint": "^1.32",
    "laravel/serializable-closure": "^2.0.10",
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3.4",
    "rector/rector": "^2.6",
    "symfony/process": "^7.4.5 || ^8.0.5"
  },
  "autoload": {
    "psr-4": {
      "Cbox\\Cms\\Testkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cbox\\Cms\\Testkit\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/Phpstan/Fixtures/"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
