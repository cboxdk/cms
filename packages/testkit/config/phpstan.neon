# Shared PHPStan configuration for the Cbox CMS kernel, the app template and addons.
# GUARDRAILS 1, 2.2 and 10 (gate 3): level 10 with Larastan, and never a baseline.
#
# A repo includes this file from vendor/cboxdk/cms-testkit/config/phpstan.neon and adds only
# its own paths. It must not lower the level, add a baseline or add ignoreErrors
# (GUARDRAILS 7.3). Larastan is found through PHPStan's own directory, so the include works
# from vendor/ and from a symlinked path package. packages/testkit/docs/static-analysis.md
# describes this configuration for addon authors.

includes:
    # First, so its bootstrap file takes the boot lock before Larastan's bootstrap boots Laravel.
    - phpstan-boot-lock.neon
    - %rootDir%/../../larastan/larastan/extension.neon

parameters:
    level: 10

    # Runs after Larastan's bootstrap, which the includes above list first, and releases the boot
    # lock. PHPStan's workers boot Laravel at the same moment, and each boot writes shared files in
    # Testbench's skeleton, so the lock lets one process at a time boot
    # (Cbox\Cms\Testkit\Phpstan\LaravelBootLock).
    bootstrapFiles:
        - phpstan-boot-unlock.php

    # Stricter than level 10 alone.
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    reportAnyTypeWideningInVarTag: true
    reportUnmatchedIgnoredErrors: true

# The layer rules of GUARDRAILS 2.2, gate 3. They reach every repo that includes this file.
# Rule 1, the Typed*Rule classes: no mixed, untyped arrays or array shapes in declarations
# outside Boundary and Adapter. Rule 2, PhpstanIgnoreRule with its collector: no phpstan-ignore
# comment outside Boundary and Adapter, read from the file tokens.
# Rule 3, TransactionCallsRule and SavepointStringsRule (GUARDRAILS 4.1, PRD 4.2): no transaction
# calls and no SAVEPOINT statements in Actions and Jobs. Rule 4, StringIdsRule (PRD 5.3): no
# public string ids outside Boundary and Adapter, except in a signature a framework interface or
# parent class requires. These report non-ignorable errors, so no
# comment and no ignoreErrors entry can hide them.
# Rule 5, the Internal*UsageExtension services with InternalUseIgnoreErrorExtension,
# InternalUseCollector and InternalUseRule (GUARDRAILS 2.3): code outside Cbox\Cms may not use
# what is marked #[Internal]. PHPStan's restricted usage rules find the uses; the extension takes
# them out of the ignorable errors and InternalUseRule reports them non-ignorable, so only an
# explicit @phpstan-ignore cboxCms.internalUse on the line hides one, never a bare ignore comment
# or an ignoreErrors entry.
# Rule 6, RawSqlRule (GUARDRAILS 6): raw SQL only in migrations and in Infrastructure and Adapter;
# everything else uses the query builder. Its errors are non-ignorable too.
# Rule 7, SystemClockRule and UuidCreationRule (GUARDRAILS 2.3, PRD 5.3): only a Clock
# implementation reads the system clock and only an IdGenerator implementation makes a UUID, so
# time and ids are deterministic in tests. Test code is not checked: a Tests namespace, or the global
# namespace below a tests directory. Migrations, config and route files are checked. The errors
# are non-ignorable.
# FunctionCallablesRule, MethodCallablesRule and StaticMethodCallablesRule apply both to
# first-class callables such as time(...), which PHPStan gives to rules as their own nodes.
rules:
    - Cbox\Cms\Testkit\Phpstan\TypedMethodsRule
    - Cbox\Cms\Testkit\Phpstan\TypedFunctionsRule
    - Cbox\Cms\Testkit\Phpstan\TypedClosuresRule
    - Cbox\Cms\Testkit\Phpstan\TypedArrowFunctionsRule
    - Cbox\Cms\Testkit\Phpstan\TypedPropertiesRule
    - Cbox\Cms\Testkit\Phpstan\TypedClassConstantsRule
    - Cbox\Cms\Testkit\Phpstan\TypedClassTagsRule
    - Cbox\Cms\Testkit\Phpstan\PhpstanIgnoreRule
    - Cbox\Cms\Testkit\Phpstan\TransactionCallsRule
    - Cbox\Cms\Testkit\Phpstan\SavepointStringsRule
    - Cbox\Cms\Testkit\Phpstan\StringIdsRule
    - Cbox\Cms\Testkit\Phpstan\RawSqlRule
    - Cbox\Cms\Testkit\Phpstan\SystemClockRule
    - Cbox\Cms\Testkit\Phpstan\UuidCreationRule
    - Cbox\Cms\Testkit\Phpstan\FunctionCallablesRule
    - Cbox\Cms\Testkit\Phpstan\MethodCallablesRule
    - Cbox\Cms\Testkit\Phpstan\StaticMethodCallablesRule
    - Cbox\Cms\Testkit\Phpstan\InternalUseRule

services:
    -
        class: Cbox\Cms\Testkit\Phpstan\PhpstanIgnoreCollector
        tags:
            - phpstan.collector
    -
        class: Cbox\Cms\Testkit\Phpstan\InternalClassNameUsageExtension
        tags:
            - phpstan.restrictedClassNameUsageExtension
    -
        class: Cbox\Cms\Testkit\Phpstan\InternalMethodUsageExtension
        tags:
            - phpstan.restrictedMethodUsageExtension
    -
        class: Cbox\Cms\Testkit\Phpstan\InternalClassConstantUsageExtension
        tags:
            - phpstan.restrictedClassConstantUsageExtension
    -
        class: Cbox\Cms\Testkit\Phpstan\InternalUseIgnoreErrorExtension
        tags:
            - phpstan.ignoreErrorExtension
    -
        class: Cbox\Cms\Testkit\Phpstan\InternalUseCollector
        tags:
            - phpstan.collector
