# Shared PHPStan configuration for the Cbox CMS kernel, the app template and addons.
# GUARDRAILS 1, 2.2 and 10 (gate 3): level 10 with Larastan, and never a baseline.
#
# A repo includes this file from vendor/cboxdk/cms-testkit/config/phpstan.neon and adds only
# its own paths. It must not lower the level, add a baseline or add ignoreErrors
# (GUARDRAILS 7.3). Larastan is found through PHPStan's own directory, so the include works
# from vendor/ and from a symlinked path package.

includes:
    - %rootDir%/../../larastan/larastan/extension.neon

parameters:
    level: 10

    # Stricter than level 10 alone.
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    reportAnyTypeWideningInVarTag: true
    reportUnmatchedIgnoredErrors: true

# The layer rules of GUARDRAILS 2.2, gate 3. They reach every repo that includes this file.
# Rule 1, the Typed*Rule classes: no mixed, untyped arrays or array shapes in declarations
# outside Boundary and Adapter. Rule 2, PhpstanIgnoreRule with its collector: no phpstan-ignore
# comment outside Boundary and Adapter, read from the file tokens.
# Both report non-ignorable errors, so no comment and no ignoreErrors entry can hide them.
rules:
    - Cbox\Cms\Testkit\Phpstan\TypedMethodsRule
    - Cbox\Cms\Testkit\Phpstan\TypedFunctionsRule
    - Cbox\Cms\Testkit\Phpstan\TypedClosuresRule
    - Cbox\Cms\Testkit\Phpstan\TypedArrowFunctionsRule
    - Cbox\Cms\Testkit\Phpstan\TypedPropertiesRule
    - Cbox\Cms\Testkit\Phpstan\TypedClassTagsRule
    - Cbox\Cms\Testkit\Phpstan\PhpstanIgnoreRule

services:
    -
        class: Cbox\Cms\Testkit\Phpstan\PhpstanIgnoreCollector
        tags:
            - phpstan.collector
