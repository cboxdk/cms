{
  "name": "cboxdk/cms-generators",
  "description": "Cbox CMS generators: the type chain from blueprints to migrations, PHP, DTOs and TypeScript.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Cbox",
      "homepage": "https://cboxdk.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "cboxdk/cms-contracts": "^0.1",
    "illuminate/console": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/support": "^13.0"
  },
  "suggest": {
    "symfony/yaml": "Required by cms:generate to read the schema. Only suggested in milestone 0, until the dependency is decided (PROGRESS.md, Blokeret)."
  },
  "autoload": {
    "psr-4": {
      "Cbox\\Cms\\Generators\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cbox\\Cms\\Generators\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cbox\\Cms\\Generators\\GeneratorsServiceProvider"
      ]
    }
  }
}
