{
  "name": "cboxdk/cms-http",
  "description": "Cbox CMS HTTP surface: REST delivery and the adapters generated from the action registry.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Cbox",
      "homepage": "https://cboxdk.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "cboxdk/cms-core": "^0.1",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Cbox\\Cms\\Http\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cbox\\Cms\\Http\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cbox\\Cms\\Http\\HttpServiceProvider"
      ]
    }
  }
}
